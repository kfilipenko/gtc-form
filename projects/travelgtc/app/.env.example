TRAVELGTC_APP_ENV=local
TRAVELGTC_API_HOST=127.0.0.1
TRAVELGTC_API_PORT=4301
TRAVELGTC_PUBLIC_LEAD_CAPTURE_ENABLED=false
TRAVELGTC_ACCOUNT_LEAD_CAPTURE_ENABLED=false
TRAVELGTC_DATABASE_URL=postgres://travelgtc_user:change-me@127.0.0.1:5432/travelgtc
TRAVELGTC_CRM_AUTH_MODE=disabled
TRAVELGTC_AGENT_INTAKE_MODE=stub
TRAVELGTC_PARENT_NETWORK_MODE=none
TRAVELGTC_CONSENT_VERSION=travelgtc-consent-v1
TRAVELGTC_IDENTITY_CONSENT_VERSION=gtc-identity-consent-v1
TRAVELGTC_SESSION_COOKIE_NAME=gtc_travelgtc_session
TRAVELGTC_SESSION_TTL_DAYS=7
TRAVELGTC_AUTH_SECURE_COOKIES=false
TRAVELGTC_AUTH_EMAIL_VERIFICATION_TEST_MODE=false
TRAVELGTC_RATE_LIMIT_WINDOW_SECONDS=60
TRAVELGTC_RATE_LIMIT_MAX=10
